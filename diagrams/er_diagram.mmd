
erDiagram
    CITIES {
        BIGINT city_id PK
        VARCHAR city_name
        VARCHAR state
    }

    CATEGORIES {
        BIGINT category_id PK
        VARCHAR category_name
        BIGINT parent_category_id FK
        BOOLEAN is_digital
    }

    SELLERS {
        BIGINT seller_id PK
        VARCHAR business_name
        VARCHAR gstin UK
        BIGINT city_id FK
        DATE joined_on
        NUMERIC seller_rating
        VARCHAR status
    }

    PRODUCTS {
        BIGINT product_id PK
        VARCHAR asin UK
        BIGINT seller_id FK
        BIGINT category_id FK
        VARCHAR title
        VARCHAR brand
        NUMERIC mrp
        NUMERIC price
        INTEGER stock_qty
        BOOLEAN is_prime_eligible
        NUMERIC avg_rating
        INTEGER review_count
        DATE listed_on
        VARCHAR status
    }

    CUSTOMERS {
        BIGINT customer_id PK
        VARCHAR full_name
        VARCHAR email UK
        VARCHAR phone UK
        BIGINT city_id FK
        DATE signup_date
        BOOLEAN is_prime
        DATE prime_since
    }

    ADDRESSES {
        BIGINT address_id PK
        BIGINT customer_id FK
        VARCHAR label
        VARCHAR line1
        BIGINT city_id FK
        VARCHAR pincode
        BOOLEAN is_default
    }

    ORDERS {
        BIGINT order_id PK
        BIGINT customer_id FK
        BIGINT address_id FK
        TIMESTAMPTZ ordered_at
        VARCHAR payment_method
        NUMERIC total_amount
        VARCHAR status
        TIMESTAMPTZ shipped_at
        TIMESTAMPTZ delivered_at
    }

    ORDER_ITEMS {
        BIGINT order_id PK, FK
        SMALLINT line_no PK
        BIGINT product_id FK
        BIGINT seller_id FK
        INTEGER quantity
        NUMERIC unit_price
    }

    RETURNS {
        BIGINT return_id PK
        BIGINT order_id FK
        SMALLINT line_no FK
        VARCHAR reason
        TIMESTAMPTZ requested_at
        VARCHAR status
        NUMERIC refund_amount
    }

    PRODUCT_REVIEWS {
        BIGINT review_id PK
        BIGINT product_id FK
        BIGINT customer_id FK
        SMALLINT rating
        VARCHAR title
        TEXT body
        BOOLEAN verified_purchase
        INTEGER helpful_votes
        TIMESTAMPTZ created_at
    }

    CART_ITEMS {
        BIGINT customer_id PK, FK
        BIGINT product_id PK, FK
        INTEGER quantity
        TIMESTAMPTZ added_at
    }

    CITIES ||--o{ SELLERS : located_in
    CITIES ||--o{ CUSTOMERS : lives_in
    CITIES ||--o{ ADDRESSES : has

    CATEGORIES o|--o{ CATEGORIES : parent_of
    CATEGORIES ||--o{ PRODUCTS : classifies

    SELLERS ||--o{ PRODUCTS : sells
    CUSTOMERS ||--o{ ADDRESSES : has
    CUSTOMERS ||--o{ ORDERS : places

    ADDRESSES o|--o{ ORDERS : delivery_address

    ORDERS ||--o{ ORDER_ITEMS : contains
    PRODUCTS ||--o{ ORDER_ITEMS : included_in
    SELLERS ||--o{ ORDER_ITEMS : supplied_by

    ORDER_ITEMS ||--o{ RETURNS : returned_through

    PRODUCTS ||--o{ PRODUCT_REVIEWS : receives
    CUSTOMERS ||--o{ PRODUCT_REVIEWS : writes

    CUSTOMERS ||--o{ CART_ITEMS : owns
    PRODUCTS ||--o{ CART_ITEMS : added_to
