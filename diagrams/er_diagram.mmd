
erDiagram
    CITIES {
        BIGINT city_id PK
        VARCHAR city_name
        VARCHAR state
    }

    CATEGORIES {
        BIGINT category_id PK
        BIGINT parent_category_id FK
        VARCHAR category_name
        BOOLEAN is_digital
    }

    SELLERS {
        BIGINT seller_id PK
        BIGINT city_id FK
        VARCHAR business_name
        VARCHAR gstin UK
        DATE joined_on
        NUMERIC seller_rating
        VARCHAR status
    }

    PRODUCTS {
        BIGINT product_id PK
        BIGINT seller_id FK
        BIGINT category_id FK
        VARCHAR title
        VARCHAR brand
        NUMERIC mrp
        NUMERIC price
        INTEGER stock_qty
    }

    CUSTOMERS {
        BIGINT customer_id PK
        VARCHAR name
        VARCHAR email UK
        VARCHAR phone
        BOOLEAN is_prime
        DATE prime_since
    }

    ADDRESSES {
        BIGINT address_id PK
        BIGINT customer_id FK
        BIGINT city_id FK
        VARCHAR address_line
        VARCHAR pincode
        BOOLEAN is_default
    }

    ORDERS {
        BIGINT order_id PK
        BIGINT customer_id FK
        BIGINT address_id FK
        DATE order_date
        VARCHAR status
    }

    ORDER_ITEMS {
        BIGINT order_id PK, FK
        INTEGER line_no PK
        BIGINT product_id FK
        BIGINT seller_id FK
        INTEGER quantity
        NUMERIC unit_price
    }

    RETURNS {
        BIGINT return_id PK
        BIGINT order_id FK
        INTEGER line_no FK
        VARCHAR reason
        VARCHAR status
        NUMERIC refund_amount
    }

    PRODUCT_REVIEWS {
        BIGINT review_id PK
        BIGINT product_id FK
        BIGINT customer_id FK
        INTEGER rating
        VARCHAR review_body
        DATE review_date
    }

    CART_ITEMS {
        BIGINT customer_id PK, FK
        BIGINT product_id PK, FK
        INTEGER quantity
        DATE added_at
    }

    CITIES ||--o{ SELLERS : located_in
    CITIES ||--o{ ADDRESSES : has

    CATEGORIES o|--o{ CATEGORIES : parent_of
    CATEGORIES ||--o{ PRODUCTS : classifies

    SELLERS ||--o{ PRODUCTS : sells
    CUSTOMERS ||--o{ ADDRESSES : has
    CUSTOMERS ||--o{ ORDERS : places

    ADDRESSES o|--o{ ORDERS : delivery_address

    ORDERS ||--|{ ORDER_ITEMS : contains
    PRODUCTS ||--o{ ORDER_ITEMS : included_in
    SELLERS ||--o{ ORDER_ITEMS : fulfilled_by

    ORDER_ITEMS ||--o{ RETURNS : returned_through

    PRODUCTS ||--o{ PRODUCT_REVIEWS : receives
    CUSTOMERS ||--o{ PRODUCT_REVIEWS : writes

    CUSTOMERS ||--o{ CART_ITEMS : owns
    PRODUCTS ||--o{ CART_ITEMS : added_to
